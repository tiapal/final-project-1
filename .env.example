# Copy to .env (or put it one folder above this repo). Never commit the real file.
PORTKEY_API_KEY=your-portkey-key-here
# Optional: password for the admin page (/#/admin). If unset, a random one is printed at server start.
ADMIN_PASSWORD=choose-a-password
# Optional: send real password-reset emails. Without these, the email is printed in the server terminal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com
# APP_URL=http://localhost:8000
